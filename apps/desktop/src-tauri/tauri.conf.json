{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "desktop",
  "version": "0.0.0",
  "identifier": "dev.chrismerck.everywhen",
  "build": {
    "frontendDist": "../dist/client/browser",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run start",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Everwhen",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
