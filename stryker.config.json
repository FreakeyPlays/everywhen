{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "vp run test"
  },
  "coverageAnalysis": "off",
  "mutate": [
    "apps/**/!(*.d|*.test|*.spec|*.stories).ts",
    "packages/*/src/**/!(*.d|*.test|*.spec).ts",
    "!apps/client/projects/desktop/src/environments/*.ts",
    "!apps/client/projects/desktop/src/main.ts",
    "!apps/client/projects/desktop/src/app/app.config.ts",
    "!apps/client/projects/desktop/src/app/app.routes.ts"
  ],
  "concurrency": 2,
  "thresholds": { "high": 90, "low": 80, "break": 90 },
  "reporters": ["clear-text", "progress", "html"],
  "htmlReporter": { "fileName": "reports/mutation/index.html" },
  "ignorePatterns": [
    "docs/**",
    "scripts/**",
    ".github/**",
    ".env*",
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/.angular/**",
    "reports/**"
  ]
}
