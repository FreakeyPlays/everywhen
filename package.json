{
  "name": "everywhen",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "prepare": "vp config",
    "version": "bun scripts/release.ts version",
    "release:preview": "bun scripts/release.ts version --dry"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@varlock/bitwarden-plugin": "^2.0.1",
    "varlock": "^1.18.0",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0"
  }
}
