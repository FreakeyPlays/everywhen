{
  "name": "everywhen",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "apps/client/projects/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "dev:web": "vp run @everywhen/client#dev",
    "dev:desktop": "vp run @everywhen/client#tauri dev",
    "build": "vp run -r build",
    "build:web": "vp run @everywhen/client#build",
    "build:desktop": "vp run @everywhen/client#tauri build",
    "test": "vp run --no-cache -r --parallel --concurrency-limit 4 test",
    "test:visual": "vp run --no-cache @everywhen/client#test:visual",
    "test:visual:update": "vp run --no-cache @everywhen/client#test:visual:update",
    "test:mutation": "stryker run",
    "test:full": "vp run test && vp run --no-cache test:mutation && vp run --no-cache test:visual",
    "knip": "knip",
    "knip:production": "knip --production",
    "deps:check": "depcruise packages apps scripts --output-type err-long",
    "deps:graph": "depcruise packages apps --include-only '^(packages/|apps/)' --output-type mermaid --output-to reports/dependencies.mmd",
    "check:static": "vp run --no-cache knip && vp run --no-cache deps:check",
    "check:type": "vp run --no-cache -r typecheck",
    "ready": "vp check && vp run check:static && vp run check:type && vp run build",
    "ready:full": "vp run ready && vp run test:full",
    "version": "bun scripts/release.ts version",
    "release:preview": "bun scripts/release.ts version --dry",
    "clean": "bun scripts/clean-workspace.ts"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "catalog:angular",
    "@stryker-mutator/core": "10.0.0",
    "@types/bun": "catalog:",
    "@varlock/bitwarden-plugin": "^2.0.1",
    "dependency-cruiser": "18.2.0",
    "knip": "^6.34.0",
    "typescript": "catalog:",
    "varlock": "^1.18.0",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "qs": "6.16.0",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.15.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "catalog": {
    "@types/bun": "^1.4.0",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "effect": "4.0.0-rc.112",
    "jsdom": "^30.0.1",
    "playwright": "1.62.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11"
  },
  "catalogs": {
    "angular": {
      "@angular/animations": "^22.1.0",
      "@angular/build": "^22.1.0",
      "@angular/cli": "^22.1.0",
      "@angular/common": "^22.1.0",
      "@angular/compiler": "^22.1.0",
      "@angular/compiler-cli": "^22.1.0",
      "@angular/core": "^22.1.0",
      "@angular/platform-browser": "^22.1.0",
      "@angular/router": "^22.1.0",
      "@angular-eslint/eslint-plugin": "^22.2.0",
      "ng-packagr": "^22.1.0",
      "rxjs": "~7.8.0"
    }
  }
}
